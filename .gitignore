# Never commit signing material or secrets.
SameDockSigning/
*.p12
*.pfx
*.cer
*.pem
*.key
*.keychain
*.keychain-db
*.mobileprovision
.env
.env.*
*.secret
*secret*.json
outputs/
releases/
