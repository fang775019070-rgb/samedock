{
  "sourceLanguage" : "en",
  "strings" : {
    "setup.checking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking permissions…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认权限…"
          }
        }
      }
    },
    "setup.captureNotActive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission is not active yet. If already enabled,\nfollow macOS’s Quit & Reopen prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限还未生效。若开关已开启，\n请按系统提示退出并重新打开 SameDock。"
          }
        }
      }
    },
    "setup.captureRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen capture was not allowed.\nCheck SameDock in Screen Recording settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统暂未允许采集缩略图。\n请在屏幕录制设置中检查 SameDock。"
          }
        }
      }
    },
    "setup.needsRelaunch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS accepted the permission.\nFollow its Quit & Reopen prompt to apply it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统已接受授权。\n请按系统提示退出并重新打开 SameDock。"
          }
        }
      }
    },
